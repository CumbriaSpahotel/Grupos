rules_version = '2';

// SAFE DEPLOY DEFAULT (22-11-2026)
// This file deliberately mirrors the production emergency lock-down.
// Do not replace it with the staging permissions until Firebase Authentication,
// membership documents, sanitized settings, and server-side payment writes
// have all been deployed and tested.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
